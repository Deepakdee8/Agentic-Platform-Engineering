[
  {
    "remediation_id": "REM-FW-001",
    "category": "FIREWALL_OPEN_INGRESS",
    "title": "Restrict Inbound SSH from Public Internet (0.0.0.0/0) to Identity-Aware Proxy (IAP)",
    "target_resource_type": "compute.googleapis.com/Firewall",
    "standard": "CIS GCP Benchmark v2.0 - 3.6",
    "automated_tool": "gcp_firewall_restrict_ssh_ingress",
    "governance_default": "REQUIRE_HUMAN_APPROVAL",
    "approver_roles": ["Cloud-Security-Lead", "Network-Admin", "Platform-Owner"],
    "cli_command": "gcloud compute firewall-rules update allow-ssh-ingress --source-ranges=35.235.240.0/20",
    "terraform_snippet": "resource \"google_compute_firewall\" \"allow_ssh\" {\n  name    = \"allow-ssh-ingress\"\n  network = \"payments-vpc\"\n  allow {\n    protocol = \"tcp\"\n    ports    = [\"22\"]\n  }\n  source_ranges = [\"35.235.240.0/20\"]\n  target_tags   = [\"production-backend\"]\n}",
    "rollback_plan": "gcloud compute firewall-rules update allow-ssh-ingress --source-ranges=0.0.0.0/0",
    "verification_probe": "gcloud compute firewall-rules describe allow-ssh-ingress --format='value(sourceRanges)'"
  },
  {
    "remediation_id": "REM-GKE-001",
    "category": "GKE_PUBLIC_ENDPOINT",
    "title": "Restrict GKE Master Control Plane Authorized Networks to Bastion CIDR",
    "target_resource_type": "container.googleapis.com/Cluster",
    "standard": "CIS GCP Benchmark v2.0 - 4.1",
    "automated_tool": "gcp_gke_disable_public_endpoint",
    "governance_default": "REQUIRE_HUMAN_APPROVAL",
    "approver_roles": ["SRE-Principal", "Platform-Owner", "Kubernetes-Lead"],
    "cli_command": "gcloud container clusters update payments-gke-prod --zone=us-central1-a --enable-master-authorized-networks --master-authorized-networks=10.128.0.0/24",
    "terraform_snippet": "resource \"google_container_cluster\" \"primary\" {\n  name = \"payments-gke-prod\"\n  master_authorized_networks_config {\n    cidr_blocks {\n      cidr_block   = \"10.128.0.0/24\"\n      display_name = \"Corporate Bastion Subnet\"\n    }\n  }\n}",
    "rollback_plan": "gcloud container clusters update payments-gke-prod --zone=us-central1-a --master-authorized-networks=0.0.0.0/0",
    "verification_probe": "gcloud container clusters describe payments-gke-prod --zone=us-central1-a --format='value(masterAuthorizedNetworksConfig.cidrBlocks)'"
  },
  {
    "remediation_id": "REM-SQL-001",
    "category": "DATABASE_PUBLIC_IP",
    "title": "Revoke Public IPv4 & Attach Private Service Access (PSA) on Cloud SQL",
    "target_resource_type": "sqladmin.googleapis.com/Instance",
    "standard": "CIS GCP Benchmark v2.0 - 6.2",
    "automated_tool": "gcp_sql_enforce_private_ip",
    "governance_default": "REQUIRE_HUMAN_APPROVAL",
    "approver_roles": ["Database-Admin", "Platform-Owner", "Security-Lead"],
    "cli_command": "gcloud sql instances patch customer-db-pg-prod --no-assign-ip --network=projects/payments-prod-vpc/global/networks/payments-vpc",
    "terraform_snippet": "resource \"google_sql_database_instance\" \"db\" {\n  name             = \"customer-db-pg-prod\"\n  database_version = \"POSTGRES_15\"\n  settings {\n    ip_configuration {\n      ipv4_enabled    = false\n      private_network = google_compute_network.vpc.id\n    }\n  }\n}",
    "rollback_plan": "gcloud sql instances patch customer-db-pg-prod --assign-ip --authorized-networks=0.0.0.0/0",
    "verification_probe": "gcloud sql instances describe customer-db-pg-prod --format='value(settings.ipConfiguration.ipv4Enabled)'"
  },
  {
    "remediation_id": "REM-BQ-001",
    "category": "BIGQUERY_DATASET_PUBLIC",
    "title": "Revoke allAuthenticatedUsers and allUsers from BigQuery Dataset Access List",
    "target_resource_type": "bigquery.googleapis.com/Dataset",
    "standard": "CIS GCP Benchmark v2.0 - 7.1",
    "automated_tool": "gcp_bigquery_revoke_public_access",
    "governance_default": "REQUIRE_HUMAN_APPROVAL",
    "approver_roles": ["Data-Governance-Officer", "Platform-Owner"],
    "cli_command": "bq update --source /tmp/revoked_access.json analytics-prod:customer_churn",
    "terraform_snippet": "resource \"google_bigquery_dataset\" \"dataset\" {\n  dataset_id = \"customer_churn\"\n  access {\n    role           = \"READER\"\n    group_by_email = \"data-analysts@enterprise.internal\"\n  }\n}",
    "rollback_plan": "bq update --add_access allAuthenticatedUsers:READER analytics-prod:customer_churn",
    "verification_probe": "bq show --format=prettyjson analytics-prod:customer_churn | grep -i allAuthenticatedUsers"
  },
  {
    "remediation_id": "REM-IAM-001",
    "category": "IAM_EXCESSIVE_PRIVILEGE",
    "title": "Downgrade Primitive roles/owner to Scoped Least-Privilege IAM Roles",
    "target_resource_type": "iam.googleapis.com/ServiceAccount",
    "standard": "CIS GCP Benchmark v2.0 - 1.4",
    "automated_tool": "gcp_iam_enforce_least_privilege",
    "governance_default": "REQUIRE_HUMAN_APPROVAL",
    "approver_roles": ["IAM-Administrator", "Platform-Owner"],
    "cli_command": "gcloud projects remove-iam-policy-binding analytics-prod --member=serviceAccount:etl-batch-sa@analytics-prod.iam.gserviceaccount.com --role=roles/owner && gcloud projects add-iam-policy-binding analytics-prod --member=serviceAccount:etl-batch-sa@analytics-prod.iam.gserviceaccount.com --role=roles/bigquery.jobUser",
    "terraform_snippet": "resource \"google_project_iam_member\" \"etl_sa\" {\n  project = \"analytics-prod\"\n  role    = \"roles/bigquery.jobUser\"\n  member  = \"serviceAccount:${google_service_account.etl.email}\"\n}",
    "rollback_plan": "gcloud projects add-iam-policy-binding analytics-prod --member=serviceAccount:etl-batch-sa@analytics-prod.iam.gserviceaccount.com --role=roles/owner",
    "verification_probe": "gcloud projects get-iam-policy analytics-prod --flatten='bindings[].members' --filter='bindings.members:etl-batch-sa'"
  },
  {
    "remediation_id": "REM-GCS-001",
    "category": "STORAGE_PUBLIC_ACCESS",
    "title": "Remove allUsers IAM Grant & Enforce Public Access Prevention (PAP)",
    "target_resource_type": "storage.googleapis.com/Bucket",
    "standard": "CIS GCP Benchmark v2.0 - 5.1",
    "automated_tool": "gcp_storage_remove_public_access",
    "governance_default": "AUTO_EXECUTE",
    "approver_roles": ["DevOps-Engineer"],
    "cli_command": "gcloud storage buckets update gs://retail-app-invoices-dev --public-access-prevention && gsutil iam ch -d allUsers:roles/storage.objectViewer gs://retail-app-invoices-dev",
    "terraform_snippet": "resource \"google_storage_bucket\" \"invoices\" {\n  name                     = \"retail-app-invoices-dev\"\n  public_access_prevention = \"enforced\"\n  uniform_bucket_level_access = true\n}",
    "rollback_plan": "gcloud storage buckets update gs://retail-app-invoices-dev --no-public-access-prevention",
    "verification_probe": "gcloud storage buckets describe gs://retail-app-invoices-dev --format='value(iamConfiguration.publicAccessPrevention)'"
  },
  {
    "remediation_id": "REM-RUN-001",
    "category": "CLOUDRUN_UNAUTHENTICATED",
    "title": "Revoke allUsers Invoker IAM Role & Enforce Authenticated Invocations on Cloud Run",
    "target_resource_type": "run.googleapis.com/Service",
    "standard": "GCP Cloud Run Security Baseline",
    "automated_tool": "gcp_cloudrun_enforce_authentication",
    "governance_default": "REQUIRE_HUMAN_APPROVAL",
    "approver_roles": ["Platform-Owner", "Application-Security-Lead"],
    "cli_command": "gcloud run services remove-iam-policy-binding payment-processor-service --region=us-central1 --member=allUsers --role=roles/run.invoker",
    "terraform_snippet": "resource \"google_cloud_run_service_iam_member\" \"member\" {\n  service  = google_cloud_run_service.service.name\n  location = \"us-central1\"\n  role     = \"roles/run.invoker\"\n  member   = \"serviceAccount:api-gateway-sa@payments-prod.iam.gserviceaccount.com\"\n}",
    "rollback_plan": "gcloud run services add-iam-policy-binding payment-processor-service --region=us-central1 --member=allUsers --role=roles/run.invoker",
    "verification_probe": "gcloud run services get-iam-policy payment-processor-service --region=us-central1 --format='value(bindings.members)'"
  },
  {
    "remediation_id": "REM-KMS-001",
    "category": "KMS_KEY_ROTATION_DISABLED",
    "title": "Configure 90-Day Automatic Cryptographic Rotation on Cloud KMS CryptoKeys",
    "target_resource_type": "cloudkms.googleapis.com/CryptoKey",
    "standard": "CIS GCP Benchmark v2.0 - 1.10",
    "automated_tool": "gcp_kms_set_rotation_schedule",
    "governance_default": "REQUIRE_HUMAN_APPROVAL",
    "approver_roles": ["Security-Lead", "Platform-Owner"],
    "cli_command": "gcloud kms keys set-rotation-schedule payment-kek --keyring=kms-prod --location=us-central1 --rotation-period=7776000s --next-rotation-time=2026-12-01T00:00:00Z",
    "terraform_snippet": "resource \"google_kms_crypto_key\" \"key\" {\n  name            = \"payment-kek\"\n  key_ring        = google_kms_key_ring.keyring.id\n  rotation_period = \"7776000s\"\n}",
    "rollback_plan": "gcloud kms keys set-rotation-schedule payment-kek --keyring=kms-prod --location=us-central1 --rotation-period=\"\"",
    "verification_probe": "gcloud kms keys describe payment-kek --keyring=kms-prod --location=us-central1 --format='value(rotationPeriod)'"
  }
]
